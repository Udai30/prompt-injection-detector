# Copy to .env and fill in. Never commit .env. Values here are placeholders only.
# The build needs NO key: it runs on local Ollama models (LLM_PROFILE=local, TRD §S10).

# --- Provider credentials (free tiers only; see configs/models.yaml) -----------
# Groq free plan: https://console.groq.com/keys
# Optional: needed only for the benchmark runs (MB.1), `pytest -m hosted` and the Space.
GROQ_API_KEY=
# Not used in this project (Gemini is not part of the model matrix); leave blank.
GEMINI_API_KEY=
# Hugging Face token (read: gated Prompt Guard 2 download; write: publishing, a human action)
HF_TOKEN=

# --- LLM provider layer (TRD §S3) ----------------------------------------------
# Which `profiles:` entry of configs/models.yaml maps LLM roles to aliases:
# local = Ollama on this machine (the build, default) | hosted = Groq (the Space)
LLM_PROFILE=local
LLM_MODELS_PATH=configs/models.yaml
LLM_PRICING_PATH=configs/pricing.yaml
# Disk cache of model responses (on for eval runs, off for live demo traffic)
LLM_CACHE_DIR=.cache/llm
# Today's request/token usage per alias (UTC day), so sweeps pause before free-tier limits
LLM_BUDGET_PATH=.cache/llm_budget.json
# Concurrent provider calls per process (1-64); local sweeps run with concurrency 1 (TRD §S9)
LLM_MAX_CONCURRENCY=1
# Hard timeout per provider call, seconds (0-600); local CPU models need the long end
LLM_TIMEOUT_S=120

# --- Local services -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# --- Runtime behaviour ----------------------------------------------------------
LOG_LEVEL=INFO
# Public demo: limit live LLM-judge checks per UTC day and fall back to cached results
DEMO_MODE=false
DEMO_DAILY_REQUESTS=100
